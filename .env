# ค่าตั้งต้นของทั้ง backend และ frontend (โหลดโดย backend/src/config.js และ frontend/server.js)
# ถ้ารันด้วย pm2 ค่าใน ecosystem.config.js (PORT / FRONTEND_PORT / BACKEND_URL) จะถูกใช้ก่อน

# ---------- เครื่องชั่ง (TCP) ----------
DEVICE_IP=172.48.2.175
DEVICE_PORT=1052
SOCKET_TIMEOUT_SEC=30
RECONNECT_DELAY_SEC=5
MIN_INSERT_INTERVAL_SEC=0

# ---------- SQL Server ----------
DB_SERVER=172.48.0.116
DB_PORT=1433
DB_NAME=AUTO_WEIGHT
DB_USER=dbthanapat
DB_PASSWORD=240630zA!!
DB_TABLE=[dbo].[Auto]
DB_ENABLED=true
DB_ENCRYPT=false
DB_TRUST_CERT=true
# false = time_stamp เป็นเวลาท้องถิ่นแบบไม่มี timezone (ตรงกับของเดิมฝั่ง Python)
DB_USE_UTC=false

# ---------- SQL Server ตัวที่สอง (Weight Checker / TunaCodes) — อ่านอย่างเดียว ----------
DB_USER_WC=sa
DB_PASSWORD_WC="Itc@#12345"
DB_SERVER_WC=172.48.0.49
DB_DATABASE_WC=ITC.SCC.IVDB.WGTCHR
PORT_WC=1433
DB_ENCRYPT_WC=false
DB_TRUST_CERT_WC=true

# ---------- เซิร์ฟเวอร์ ----------
PORT=8000
FRONTEND_PORT=3000
BACKEND_URL=http://127.0.0.1:8000
MEMORY_BUFFER_SIZE=5000

# ---------- โหมดทดสอบ ----------
# SIM_MODE=true  -> สร้างค่าน้ำหนักจำลอง ไม่ต้องต่อเครื่องชั่งจริง (ไว้เทสต์ dashboard)
SIM_MODE=false
SIM_INTERVAL_MS=900
